<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Noticias Políticas del Perú</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <header class="mb-8 text-center border-b pb-4">
      <h1 class="text-4xl font-bold text-red-700">Política Perú</h1>
      <p class="text-gray-500 mt-2">Última actualización: <%= ultimaActualizacion %></p>
    </header>

    <main class="grid gap-6 md:grid-cols-2">
      <% noticias.forEach(noticia => { %>
        <article class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition">
          <span class="text-xs font-semibold uppercase px-2 py-1 bg-red-100 text-red-800 rounded">
            <%= noticia.fuente %>
          </span>
          <h2 class="text-xl font-bold mt-2">
            <a href="<%= noticia.link %>" target="_blank" class="hover:text-red-600">
              <%= noticia.titulo %>
            </a>
          </h2>
          <p class="text-gray-600 text-sm mt-2"><%= noticia.resumen %></p>
          <time class="block text-xs text-gray-400 mt-4"><%= noticia.fecha %></time>
        </article>
      <% }) %>
    </main>
  </div>
</body>
</html>